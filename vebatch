#!/usr/bin/env bash

# f=/media/jph/slow_bad_3/2026/09/2026090218291302_ghost_80.mp4

cargo install --path .

n=$(nproc)
echo running on $n cpus

for f in $*
do
    echo ''
    f2long=${f%.*}.txt
    f2short=${f2long##*/}
    f2="${f2short}"
    echo process $f to $f2
    if [ -f "$f2" ];then
        echo $f2 already exists
    else
        #echo ''
        #echo cargo run -- --in $f --out $f2 --parallel-count 16 --skip 4
        #cargo run -- --in $f --out $f2 --parallel-count 16 --skip 4
        echo videye --in $f --out $f2 --parallel-count $n --skip 3
        time videye --in $f --out $f2 --parallel-count $n --skip 3
    fi
done
